---
import {ui,pageUrl,type Locale} from '../locales';
const {locale='en',pageId='home'}=Astro.props;const t=ui(locale as Locale);
const productLinks=[['features',t.allFeatures],['student-billing',t.studentBilling],['receipts-and-payments',t.receipts],['debtors',t.debtors],['multi-currency',t.currencies]];
const institutionLinks=[['institutions',t.learningInstitutions],['institutions/schools',t.schools],['institutions/colleges-and-training',t.colleges]];
---
<header class="site-header"><a class="site-brand" href={pageUrl('home',locale)} aria-label={'Bursara '+t.home}><img src="/bursara-logo-navy.svg" alt="Bursara" width="166" height="47"/></a><nav class="desktop-navigation" aria-label={t.mainNavigation}><details class="nav-disclosure"><summary>{t.product} <span aria-hidden="true">⌄</span></summary><div class="nav-dropdown">{productLinks.map(([id,label])=><a href={pageUrl(id,locale)} aria-current={pageId===id?'page':undefined}>{label}<span aria-hidden="true">↗</span></a>)}</div></details><details class="nav-disclosure"><summary>{t.institutions} <span aria-hidden="true">⌄</span></summary><div class="nav-dropdown">{institutionLinks.map(([id,label])=><a href={pageUrl(id,locale)} aria-current={pageId===id?'page':undefined}>{label}<span aria-hidden="true">↗</span></a>)}</div></details>{[['about',t.about],['help',t.help],['contact',t.contact]].map(([id,label])=><a href={pageUrl(id,locale)} aria-current={pageId===id?'page':undefined}>{label}</a>)}</nav><nav class="language-switch" aria-label={t.language}>{(['en','fr'] as const).map(language=><a href={pageUrl(pageId,language)} data-language={language} lang={language} aria-current={locale===language?'true':undefined}>{language.toUpperCase()}</a>)}</nav><a class="site-app-link" href="https://app.bursara.com">{t.openApp} <span aria-hidden="true">↗</span></a><details class="mobile-navigation"><summary aria-label={t.openNavigation}>{t.menu} <span aria-hidden="true">☰</span></summary><nav aria-label={t.mobileNavigation}><strong>{t.product}</strong>{productLinks.map(([id,label])=><a href={pageUrl(id,locale)}>{label}</a>)}<strong>{t.institutions}</strong>{institutionLinks.map(([id,label])=><a href={pageUrl(id,locale)}>{label}</a>)}<strong>{t.resources}</strong>{[['about',t.aboutBursara],['help',t.helpGuides],['contact',t.contactTeam]].map(([id,label])=><a href={pageUrl(id,locale)}>{label}</a>)}</nav></details></header>
<script>
document.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach(link=>link.addEventListener('click',()=>{const domain=location.hostname==='bursara.com'||location.hostname.endsWith('.bursara.com')?'; Domain=.bursara.com':'';document.cookie='bursara_locale='+link.dataset.language+'; Path=/; Max-Age=31536000; SameSite=Lax'+domain+(location.protocol==='https:'?'; Secure':'');}));
const menus=Array.from(document.querySelectorAll<HTMLDetailsElement>('.nav-disclosure, .mobile-navigation'));menus.forEach(menu=>menu.addEventListener('toggle',()=>{if(menu.open)menus.forEach(other=>{if(other!==menu)other.open=false;});}));document.addEventListener('click',event=>menus.forEach(menu=>{if(event.target instanceof Node&&!menu.contains(event.target))menu.open=false;}));document.addEventListener('keydown',event=>{if(event.key==='Escape')menus.forEach(menu=>{if(menu.open){menu.open=false;menu.querySelector('summary')?.focus();}});});
</script>

---
import Site from '../../layouts/Site.astro';import {ui,manual,pageUrl,type Locale} from '../../locales';import '../../styles/help-index.css';const {locale='en'}=Astro.props;const t=ui(locale as Locale);const data=manual(locale);const download='/downloads/bursara-user-manual'+(locale==='fr'?'-fr':'');
const definitions=[
 {title:'Getting started',description:'Sign in, find the right screen and understand the account.',slugs:['start-here','money-words','sign-in','passkeys-and-verification','navigation-help','overview']},
 {title:'Programmes & learners',description:'Build the fee structure and enrol the student.',slugs:['create-course','fixed-unit','per-credit-unit','enrol-student','edit-records','products-and-prices','vat-and-tax-pricing','student-account']},
 {title:'Bills & instalments',description:'Raise fees and choose how the balance becomes due.',slugs:['billing-workflows','edit-and-post-drafts','recurring-invoices','manage-recurring-invoices','annual-bill','instalment-schedule','university-unit-bill','receive-and-issue','read-invoice']},
 {title:'Payments & corrections',description:'Record money received, allocate it and handle adjustments.',slugs:['part-payment','allocate-payments','cross-currency','advance-payment','apply-student-credit','refund-unused-credit','credit-fees','receipt-print','print-statement']},
 {title:'Debtors & reporting',description:'Review what remains unpaid and follow the figures.',slugs:['debtors','reports-export','financial-journal']},
 {title:'People & institution access',description:'Manage users, rights and authorised platform support.',slugs:['create-user','user-rights','institution-settings','platform-create-institution','platform-support-access']},
 {title:'Fiscal module & further help',description:'Explore the optional sandbox module and troubleshoot.',slugs:['ebs-settings','ebs-workflow','mobile-use','common-problems','support-and-glossary']}
];
const groups=definitions.map((g,i)=>({...g,title:t.guideGroups[i][0],description:t.guideGroups[i][1]}));
---

<Site locale={locale} pageId="help" title={t.helpMetaTitle} description={t.helpMetaDescription}><main id="main-content"><section class="content-wrap help-intro"><nav aria-label={t.breadcrumb}><ol class="breadcrumb-list"><li><a href={pageUrl('home',locale)}>{t.home}</a></li><li>{t.helpGuides}</li></ol></nav><span class="product-eyebrow">{t.guideTitle}</span><h1>{t.helpHeading[0]}<br/>{t.helpHeading[1]}</h1><p>{t.helpIntro}</p><div class="product-actions"><a class="product-button" href={pageUrl('guide:start-here',locale)}>{t.startBasics} →</a><a class="product-text-link" href={download+'.pdf'} download>{t.downloadPdf} ↓</a><a class="product-text-link" href={download+'.html'} download>{t.downloadHtml} ↓</a></div></section><section class="help-library"><div class="content-wrap"><div class="guide-search-row"><label for="guide-search">{t.findGuide}</label><div class="guide-search"><span aria-hidden="true">⌕</span><input id="guide-search" type="search" placeholder={t.searchPlaceholder} autocomplete="off"/></div><output id="guide-count" data-singular={t.guide} data-plural={t.guides} aria-live="polite">{data.chapters.length} {t.guides}</output></div><div id="no-guide-results" hidden><h2>{t.noGuides}</h2><p>{t.shorterSearch}</p></div>{groups.map(group=><section class="guide-group"><div class="guide-group-heading"><h2>{group.title}</h2><p>{group.description}</p></div><div class="guide-cards">{group.slugs.map(slug=>data.chapters.find(c=>c.slug===slug)).filter(Boolean).map(chapter=><a class="guide-card" href={pageUrl('guide:'+chapter.slug,locale)} data-search={(chapter.title+' '+chapter.summary).toLowerCase()}><span>{t.guideTitle} ↗</span><h3>{chapter.title}</h3><p>{chapter.summary}</p></a>)}</div></section>)}</div></section><section class="content-wrap help-boundary"><div><span class="product-eyebrow">BURSARA</span><h2>{t.currentGuide}</h2><p>{t.guideBoundary}</p></div><div class="help-contact"><h3>{t.stillHelp}</h3><p>{t.supportInstructions}</p><a class="product-text-link" href={pageUrl('contact',locale)}>{t.contactTeam} ↗</a></div></section></main></Site>
<script>
const input=document.querySelector<HTMLInputElement>('#guide-search');const count=document.querySelector<HTMLOutputElement>('#guide-count');
input?.addEventListener('input',()=>{const query=input.value.trim().toLowerCase();let visible=0;document.querySelectorAll<HTMLElement>('.guide-card').forEach(card=>{const match=card.dataset.search?.includes(query)===true;card.hidden=!match;if(match)visible++;});document.querySelectorAll<HTMLElement>('.guide-group').forEach(group=>{group.hidden=Array.from(group.querySelectorAll<HTMLElement>('.guide-card')).every(card=>card.hidden);});if(count)count.textContent=`${visible} ${visible===1?count.dataset.singular:count.dataset.plural}`;const empty=document.querySelector<HTMLElement>('#no-guide-results');if(empty)empty.hidden=visible!==0;});
</script>

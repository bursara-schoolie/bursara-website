---
import Site from '../../layouts/Site.astro';
import {ui,pageUrl,type Locale} from '../../locales';
import '../../styles/home.css';
const {locale='en'}=Astro.props;const t=ui(locale as Locale);const h=t.homeData;
const featureIds=['student-billing','receipts-and-payments','debtors'];
const schema={'@context':'https://schema.org','@type':'WebSite',name:'Bursara',url:'https://bursara.com'+pageUrl('home',locale),description:h.description,publisher:{'@type':'Organization',name:'Streak Technologies Ltd',url:'https://streaktechnologies.com',email:'support@streaktechnologies.com',telephone:'+2302152998'}};
---
<Site locale={locale} pageId="home" schema={schema} title={h.title} description={h.description}><main id="main-content"><section class="hero wrap"><div class="hero-copy"><div class="eyebrow"><span></span>{h.eyebrow}</div><h1>{h.heading[0]}<br/>{h.heading[1]}<br/><em>{h.heading[2]}</em></h1><p>{h.intro}</p><div class="actions"><a class="button" href="https://app.bursara.com">{t.explore} →</a><a class="text-link" href={pageUrl('features',locale)}>{h.meet} →</a></div><div class="hero-note">{h.note}</div></div><div class="preview-scene" aria-label={t.illustration}><div class="stripe"></div><div class="preview-top"><span class="tiny-mark">▥</span><span>{h.previewTitle}</span><span class="demo">{t.illustration}</span></div><div class="profile"><div class="avatar">AM</div><div><strong>Alex Morgan</strong><small>{h.previewProgramme}</small></div><span class="chip">{h.active}</span></div><div class="account-values"><div><small>{h.annual}</small><strong>120,000<span>.00</span></strong></div><div><small>{h.paid}</small><strong>25,000<span>.00</span></strong></div></div><div class="progress"><span></span></div><div class="progress-label"><span>{h.progress}</span><strong>{h.paidPercent}</strong></div><div class="balance"><div><small>{h.remaining}</small><strong>95,000.00</strong></div><span>{h.statement} →</span></div><div class="activity-title">{h.activity}<span>{h.viewAll}</span></div><div class="activity"><div class="activity-icon">↓</div><div><strong>{h.partPayment}</strong><small>{h.transfer}</small></div><b>25,000</b></div><div class="activity"><div class="activity-icon muted">▤</div><div><strong>{h.annualInvoice}</strong><small>{h.schedule}</small></div><b>120,000</b></div><div class="preview-footer"><span class="dot"></span>{h.oneAccount}</div></div></section><section class="institution-bar"><div class="wrap"><span>{h.forLearning}</span>{h.institutionTypes.map((label,i)=><a href={pageUrl(i%2?'institutions/colleges-and-training':'institutions/schools',locale)}>{label}</a>)}</div></section><section class="wrap section" id="product"><div class="eyebrow">{h.featureEyebrow}</div><h2>{h.featureHeading[0]}<br/>{h.featureHeading[1]}</h2><div class="feature-grid">{h.features.map(([number,title,description],i)=><article><span class="number">{number}</span><h3><a href={pageUrl(featureIds[i],locale)}>{title}</a></h3><p>{description}</p><a class="feature-link" href={pageUrl(featureIds[i],locale)}>{t.seeWorkflow} ↗</a></article>)}</div></section><section class="billing-section"><div class="wrap billing-grid"><div><div class="eyebrow">{h.billingEyebrow}</div><h2>{h.billingHeading[0]}<br/>{h.billingHeading[1]}</h2><p>{h.billingIntro}</p><a class="text-link" href="https://app.bursara.com">{h.viewWorkspace} →</a></div><div class="steps">{h.steps.map(([title,text],i)=><article><span>{i+1}</span><div><h3>{title}</h3><p>{text}</p></div></article>)}</div></div></section><section class="wrap section modules"><div><div class="eyebrow">{h.moduleEyebrow}</div><h2>{h.moduleHeading[0]}<br/>{h.moduleHeading[1]}</h2><p>{h.moduleIntro}</p></div><article class="module-card"><div class="module-icon">MU</div><div><span class="label">{h.moduleLabel}</span><h3>{h.moduleTitle}</h3><p>{h.moduleText}</p><small>{h.moduleNote}</small><a class="feature-link" href={pageUrl('guide:ebs-settings',locale)}>{t.findHelp} ↗</a></div></article></section><section class="wrap final-cta"><div><span class="eyebrow">BURSARA</span><h2>{h.ctaHeading}</h2><p>{h.ctaIntro}</p></div><a href="https://app.bursara.com" class="button light">{h.ctaButton} ↗</a></section><section class="wrap section contact"><div><span class="eyebrow">STREAK TECHNOLOGIES LTD</span><h2>{h.contactHeading}</h2><p>{h.contactIntro}</p><a class="button" href={pageUrl('contact',locale)}>{t.contactTeam} ↗</a></div><div class="contact-details"><h3>Streak Technologies Ltd</h3><p>Royal Road, Pointe aux Cannoniers<br/>Grand Bay, {t.mauritius}</p><a href="tel:+2302152998">+230 215 2998</a><p>{t.usa}: <a href="tel:+13075003256">+1 307 500 3256</a></p><a href="mailto:support@streaktechnologies.com">support@streaktechnologies.com</a><p><a href="https://streaktechnologies.com">streaktechnologies.com ↗</a></p></div></section></main></Site>

---
import Site from '../../layouts/Site.astro';import {ui,manual,pageUrl,type Locale} from '../../locales';import '../../styles/help-article.css';const {locale='en',slug}=Astro.props;const t=ui(locale as Locale);const data=manual(locale);const index=data.chapters.findIndex(c=>c.slug===slug);if(index<0)throw new Error('Missing guide');const chapter=data.chapters[index];const previous=data.chapters[index-1];const next=data.chapters[index+1];const download='/downloads/bursara-user-manual'+(locale==='fr'?'-fr':'')+'.pdf';
---

<Site locale={locale} pageId={'guide:'+chapter.slug} title={chapter.title+' | '+t.guideTitle} description={chapter.summary}><main id="main-content"><section class="content-wrap guide-intro"><nav aria-label={t.breadcrumb}><ol class="breadcrumb-list"><li><a href={pageUrl('home',locale)}>{t.home}</a></li><li><a href={pageUrl('help',locale)}>{t.helpGuides}</a></li><li>{chapter.title}</li></ol></nav><span class="product-eyebrow">{t.guideTitle} / {String(index+1).padStart(2,'0')}</span><h1>{chapter.title}</h1><p>{chapter.summary}</p><div class="guide-utilities"><a href={pageUrl('help',locale)}>← {t.allGuides}</a><a href={download} download>{t.downloadPdf} ↓</a></div></section><div class="content-wrap guide-layout"><aside class="guide-outline"><h2>{t.onPage}</h2><nav aria-label={t.guideSections}>{chapter.sections.map((section,i)=><a href={'#step-section-'+(i+1)}>{section.heading}</a>)}</nav><div><strong>{t.workingDemo}</strong><p>{t.fictional}</p><a href={pageUrl('contact',locale)}>{t.askHelp} ↗</a></div></aside><article class="guide-article">{chapter.sections.map((section,i)=><section class="guide-procedure" id={'step-section-'+(i+1)}><h2>{section.heading}</h2>{section.paragraphs?.map(paragraph=><p>{paragraph}</p>)}{section.steps&&<ol>{section.steps.map(step=><li>{step}</li>)}</ol>}{section.image&&<figure><a href={section.image.src.replace('images/','/help/images/')} aria-label={t.openImage+section.image.alt}><img src={section.image.src.replace('images/','/help/images/')} alt={section.image.alt} width={section.image.width} height={section.image.height} loading="lazy" decoding="async"/></a><figcaption>{section.image.caption}</figcaption></figure>}</section>)}<nav class="guide-pagination" aria-label={t.guideSections}>{previous?<a href={pageUrl('guide:'+previous.slug,locale)}><span>← {t.previousGuide}</span><strong>{previous.title}</strong></a>:<span/>}{next&&<a href={pageUrl('guide:'+next.slug,locale)}><span>{t.nextGuide} →</span><strong>{next.title}</strong></a>}</nav></article></div></main></Site>

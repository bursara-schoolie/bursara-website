---
import Site from '../../layouts/Site.astro';import {ui,pageUrl,type Locale} from '../../locales';import '../../styles/contact.css';const {locale='en'}=Astro.props;const t=ui(locale as Locale);const c=t.contactData;
---
<Site locale={locale} pageId="contact" title={c.title} description={c.description}><main id="main-content"><section class="content-wrap contact-introduction"><nav aria-label={t.breadcrumb}><ol class="breadcrumb-list"><li><a href={pageUrl('home',locale)}>{t.home}</a></li><li>{t.contact}</li></ol></nav><span class="product-eyebrow">{c.eyebrow}</span><h1>{c.heading}</h1><p>{c.intro}</p></section><section class="content-wrap contact-grid"><article class="contact-primary"><span class="product-eyebrow">{c.conversation}</span><h2>{c.human}</h2><p>{c.emailIntro}</p><a class="contact-email" href="mailto:support@streaktechnologies.com?subject=Bursara">support@streaktechnologies.com <span aria-hidden="true">↗</span></a><div class="contact-subjects"><a href="mailto:support@streaktechnologies.com?subject=Bursara">{c.institution} →</a><a href="mailto:support@streaktechnologies.com?subject=Bursara%20feedback">{c.feedback} →</a></div><small>{c.opensEmail}</small></article><div class="contact-offices"><article><span class="product-eyebrow">{t.mauritius}</span><h2>Streak Technologies Ltd</h2><address>Royal Road, Pointe aux Cannoniers<br/>Grand Bay, {t.mauritius}</address><a href="tel:+2302152998">+230 215 2998</a></article><article><span class="product-eyebrow">{t.usa}</span><h2>{c.usaHeading}</h2><a href="tel:+13075003256">+1 307 500 3256</a><p>{c.companyIntro} <a href="https://streaktechnologies.com">streaktechnologies.com ↗</a></p></article></div></section><section class="content-wrap enquiry-notes"><article><h2>{c.before}</h2><p>{c.beforeText}</p></article><article><h2>{c.report}</h2><p>{c.reportText}</p><a href={pageUrl('help',locale)}>{t.helpGuides} →</a></article></section><section class="page-cta"><div><h2>{c.look}</h2><p>{c.lookText}</p></div><a class="product-button" href="https://app.bursara.com">{t.openApp} ↗</a></section></main></Site>

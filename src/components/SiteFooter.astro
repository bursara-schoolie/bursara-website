---
import {ui,pageUrl,type Locale} from '../locales';const {locale='en'}=Astro.props;const t=ui(locale as Locale);
---
<footer class="site-footer"><div class="footer-main"><div class="footer-brand"><a href={pageUrl('home',locale)}><img src="/bursara-logo-navy.svg" alt="Bursara" width="153" height="43"/></a><p>{t.tagline[0]}<br/>{t.tagline[1]}</p><small>{t.by} <a href="https://streaktechnologies.com">Streak Technologies Ltd ↗</a></small></div><div><h2>{t.workspace}</h2>{[['features',t.allFeatures],['student-billing',t.studentBilling],['receipts-and-payments',t.receipts],['debtors',t.debtors],['multi-currency',t.currencies]].map(([id,label])=><a href={pageUrl(id,locale)}>{label}</a>)}</div><div><h2>{t.yourInstitution}</h2>{[['institutions',t.learningInstitutions],['institutions/schools',t.schools],['institutions/colleges-and-training',t.colleges],['about',t.aboutBursara],['help',t.helpGuides]].map(([id,label])=><a href={pageUrl(id,locale)}>{label}</a>)}</div><div class="footer-contact"><h2>{t.letsTalk}</h2><a href="mailto:support@streaktechnologies.com">support@streaktechnologies.com</a><a href="tel:+2302152998">{t.mauritius}: +230 215 2998</a><a href="tel:+13075003256">{t.usa}: +1 307 500 3256</a><p>Royal Road, Pointe aux Cannoniers<br/>Grand Bay, {t.mauritius}</p><a href={pageUrl('contact',locale)}>{t.contactDetails} ↗</a></div></div><div class="footer-bottom"><small>© {new Date().getFullYear()} Bursara · Streak Technologies Ltd</small><nav aria-label={t.legalNavigation}><a href={pageUrl('privacy',locale)}>{t.privacy}</a><a href={pageUrl('terms',locale)}>{t.terms}</a></nav></div></footer>

---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
const { title, description, noindex = false, schema } = Astro.props;
const release = process.env.CF_PAGES_COMMIT_SHA || import.meta.env.CF_PAGES_COMMIT_SHA || 'local';
const canonical = new URL(Astro.url.pathname.endsWith('/') || Astro.url.pathname.endsWith('.html') ? Astro.url.pathname : Astro.url.pathname+'/', 'https://bursara.com').href;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="preload" href="/Manrope.ttf" as="font" type="font/ttf" crossorigin="anonymous"/><link rel="icon" type="image/svg+xml" href="/bursara-favicon.svg"/><meta name="bursara-release" content={release}/><meta name="theme-color" content="#172B4D"/><meta property="og:type" content="website"/><meta property="og:site_name" content="Bursara"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content="https://bursara.com/bursara-social.png"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="Bursara. Clear accounts. More room to learn. Student billing, receipts and financial clarity."/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content="https://bursara.com/bursara-social.png"/><meta name="twitter:image:alt" content="Bursara school finance workspace by Streak Technologies Ltd"/>{noindex&&<meta name="robots" content="noindex, follow"/>}{schema&&<script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>}<slot name="head"/></head><body><a class="skip-link" href="#main-content">Skip to content</a><SiteHeader/><slot/><SiteFooter/></body></html>
<style is:global>
@font-face{font-family:Manrope;src:url('/Manrope.ttf') format('truetype');font-display:swap;font-weight:200 800}:root{--navy:#172b4d;--gold:#b48b3e;--paper:#fbfaf7;--muted:#6e7c91;--line:#dfe4eb;font-family:Manrope,system-ui,sans-serif;color:var(--navy);background:var(--paper);font-synthesis:none}*{box-sizing:border-box}body{margin:0;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}a,button,summary{-webkit-tap-highlight-color:transparent}a:focus-visible,summary:focus-visible,button:focus-visible{outline:3px solid #b48b3e;outline-offset:5px}a:hover{color:#99722e}p{line-height:1.85}.skip-link{position:fixed;left:18px;top:-80px;z-index:100;background:#172b4d;color:#fff;padding:13px 20px;border-radius:5px}.skip-link:focus{top:15px}.site-header{max-width:1250px;margin:auto;min-height:110px;padding:25px 36px;display:flex;align-items:center;gap:34px;position:relative;z-index:20}.site-brand{display:block;margin-right:auto;flex-shrink:0}.site-brand img{display:block;width:166px;height:47px}.desktop-navigation{display:flex;align-items:center;gap:27px;font-size:12px;font-weight:650}.desktop-navigation>a{padding:12px 0}.desktop-navigation [aria-current=page],.desktop-navigation .current{color:#9a7330}.nav-disclosure{position:relative}.nav-disclosure>summary{display:flex;gap:9px;align-items:center;list-style:none;cursor:pointer;padding:12px 0}.nav-disclosure>summary::-webkit-details-marker,.mobile-navigation>summary::-webkit-details-marker{display:none}.nav-dropdown{position:absolute;top:100%;left:-18px;min-width:260px;background:white;padding:10px;border:1px solid var(--line);border-top:3px solid var(--gold);border-radius:6px;box-shadow:0 15px 30px #172b4d12;display:grid}.nav-dropdown>a{display:flex;justify-content:space-between;gap:20px;padding:13px 12px;font-size:12px;border-radius:4px}.nav-dropdown>a:hover{background:#f1f4f8;color:var(--navy)}.nav-dropdown>a>span{color:#a5afbc}.site-app-link{display:inline-flex;align-items:center;gap:22px;background:va
---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { pageUrl, ui, type Locale } from '../locales';
import '../styles/site.css';
const { title, description, noindex = false, schema, locale = 'en', pageId = 'home' } = Astro.props;
const t=ui(locale as Locale);
const release=process.env.CF_PAGES_COMMIT_SHA||import.meta.env.CF_PAGES_COMMIT_SHA||'local';
const absolute=(language:Locale)=>'https://bursara.com'+pageUrl(pageId,language);
const canonical=absolute(locale);
---
<!doctype html><html lang={locale} data-en={pageUrl(pageId,'en')} data-fr={pageUrl(pageId,'fr')}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="en" href={absolute('en')}/><link rel="alternate" hreflang="fr" href={absolute('fr')}/><link rel="alternate" hreflang="x-default" href={absolute('en')}/><link rel="preload" href="/Manrope.ttf" as="font" type="font/ttf" crossorigin="anonymous"/><link rel="icon" type="image/svg+xml" href="/bursara-favicon.svg"/><meta name="bursara-release" content={release}/><meta name="theme-color" content="#172B4D"/><meta property="og:type" content="website"/><meta property="og:site_name" content="Bursara"/><meta property="og:locale" content={locale==='fr'?'fr_FR':'en_GB'}/><meta property="og:locale:alternate" content={locale==='fr'?'en_GB':'fr_FR'}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={'https://bursara.com/bursara-social'+(locale==='fr'?'-fr':'')+'.png'}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content={t.socialAlt}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={'https://bursara.com/bursara-social'+(locale==='fr'?'-fr':'')+'.png'}/><meta name="twitter:image:alt" content={t.socialAlt}/>{noindex&&<meta name="robots" content="noindex, follow"/>}{schema&&<script type="application/ld+json" set:html={JSON.stringify({...schema,inLanguage:locale}).replace(/</g,'\\u003c')}/>}<slot name="head"/>
<script is:inline>
(function(){const root=document.documentElement;const saved=document.cookie.split('; ').find(v=>v.startsWith('bursara_locale='))?.split('=')[1];const explicit=root.lang==='fr';const chosen=explicit?'fr':(saved==='en'||saved==='fr'?saved:(navigator.language||'en').toLowerCase().startsWith('fr')?'fr':'en');const domain=location.hostname==='bursara.com'||location.hostname.endsWith('.bursara.com')?'; Domain=.bursara.com':'';document.cookie='bursara_locale='+chosen+'; Path=/; Max-Age=31536000; SameSite=Lax'+domain+(location.protocol==='https:'?'; Secure':'');if(chosen!==root.lang){const target=root.dataset[chosen];if(target)location.replace(target+location.search+location.hash);}})();
</script></head><body><a class="skip-link" href="#main-content">{t.skip}</a><SiteHeader locale={locale} pageId={pageId}/><slot/><SiteFooter locale={locale}/></body></html>

---
import Site from './Site.astro';
import {products,pageUrl,ui,type Locale} from '../locales';

const { page, locale='en' } = Astro.props;const t=ui(locale as Locale);const pages=products(locale);
const related = page.related.map(path=>pages.find(p=>p.path===path)).filter(Boolean);
const crumbs=page.path.startsWith('institutions/')?[[pageUrl('institutions',locale),t.institutions]]:[];
const schema={ '@context':'https://schema.org','@type':'WebPage',name:page.title,description:page.description,url:'https://bursara.com'+pageUrl(page.path,locale),isPartOf:{'@type':'WebSite',name:'Bursara',url:'https://bursara.com/'}};
---
<Site locale={locale} pageId={page.path} title={page.title+' | Bursara'} description={page.description} schema={schema}><main id="main-content"><section class="content-wrap product-hero"><div><nav aria-label={t.breadcrumb}><ol class="breadcrumb-list"><li><a href={pageUrl('home',locale)}>{t.home}</a></li>{crumbs.map(([href,label])=><li><a href={href}>{label}</a></li>)}<li aria-current="page">{page.label}</li></ol></nav><span class="product-eyebrow">{page.eyebrow}</span><h1>{page.heading}</h1><p class="product-intro">{page.intro}</p><div class="product-actions"><a class="product-button" href="https://app.bursara.com">{t.explore} <span aria-hidden="true">↗</span></a><a class="product-text-link" href={pageUrl('contact',locale)}>{t.talkTeam} →</a></div></div><aside class="ledger-card" aria-label={t.illustration}><div class="ledger-stripe"></div><div class="ledger-card-head"><span>{page.cardTitle}</span><small>{t.illustration}</small></div><div class="ledger-card-body">{page.cardRows.map(([label,value]:string[])=><div class="ledger-card-row"><span>{label}</span><strong>{value}</strong></div>)}</div><div class="ledger-card-foot">{page.cardNote}</div></aside></section><nav class="page-jump-nav" aria-label={t.onPage}><div class="content-wrap"><span>{t.onPage}</span>{page.sections.map((section,i)=><a href={'#section-'+(i+1)}>{section.nav||section.heading}</a>)}<a href="#questions">{t.questions}</a></div></nav><section class="content-wrap page-body"><div class="content-sections">{page.sections.map((section,i)=><article class="content-section" id={'section-'+(i+1)}><h2>{section.heading}</h2>{section.body.map((paragraph:string)=><p>{paragraph}</p>)}{section.points&&<ul>{section.points.map((point:string)=><li>{point}</li>)}</ul>}</article>)}</div></section><section class="workflow-example"><div class="content-wrap example-grid"><div><span class="product-eyebrow">{page.example.eyebrow||t.example}</span><h2>{page.example.title}</h2><p>{page.example.body}</p></div><div class="example-values">{page.example.rows.map(([label,value]:string[])=><div class="example-value"><span>{label}</span><strong>{value}</strong></div>)}</div></div></section><section class="faq-section" id="questions"><div class="content-wrap faq-grid"><div class="faq-heading"><span class="product-eyebrow">{t.questionsAnswered}</span><h2>{page.faqHeading||t.moreClarity}</h2><p>{t.figuresIntro}</p><a class="product-text-link" href={pageUrl('help',locale)}>{t.findHelp} →</a></div><div class="faq-list">{page.faq.map(([question,answer]:string[])=><details><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>{related.length>0&&<section class="related-section"><h2>{t.keepExploring}</h2><div class="related-grid">{related.map(p=><a class="related-card" href={pageUrl(p.path,locale)}><span>{t.explore} ↗</span><h3>{p.label}</h3><p>{p.relatedDescription||p.description}</p></a>)}</div></section>}<section class="page-cta"><div><h2>{t.seeWorkflow}</h2><p>{t.seeWorkflowText}</p></div><a class="product-button" href="https://app.bursara.com">{t.openWorkspace} ↗</a></section></main></Site>

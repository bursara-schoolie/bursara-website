---
import Site from './Site.astro';
import { pages, type ProductPage } from '../data/pages';
interface Props { page: ProductPage }
const { page } = Astro.props;
const related = page.related.map(path=>pages.find(p=>p.path===path)).filter((p):p is ProductPage=>Boolean(p));
const crumbs=page.path.startsWith('institutions/')?[['/institutions/','Institutions']]:[];
const schema={ '@context':'https://schema.org','@type':'WebPage',name:page.title,description:page.description,url:'https://bursara.com/'+page.path+'/',isPartOf:{'@type':'WebSite',name:'Bursara',url:'https://bursara.com/'}};
---
<Site title={page.title+' | Bursara'} description={page.description} schema={schema}><main id="main-content"><section class="content-wrap product-hero"><div><nav aria-label="Breadcrumb"><ol class="breadcrumb-list"><li><a href="/">Home</a></li>{crumbs.map(([href,label])=><li><a href={href}>{label}</a></li>)}<li aria-current="page">{page.label}</li></ol></nav><span class="product-eyebrow">{page.eyebrow}</span><h1>{page.heading}</h1><p class="product-intro">{page.intro}</p><div class="product-actions"><a class="product-button" href="https://app.bursara.com">Explore the alpha <span aria-hidden="true">↗</span></a><a class="product-text-link" href="/contact/">Talk to the team →</a></div><p class="alpha-caption">Available for alpha evaluation using synthetic records.</p></div><aside class="ledger-card" aria-label="Illustrative workflow"><div class="ledger-stripe"></div><div class="ledger-card-head"><span>{page.cardTitle}</span><small>ILLUSTRATION</small></div><div class="ledger-card-body">{page.cardRows.map(([label,value]:string[])=><div class="ledger-card-row"><span>{label}</span><strong>{value}</strong></div>)}</div><div class="ledger-card-foot">{page.cardNote}</div></aside></section><nav class="page-jump-nav" aria-label="On this page"><div class="content-wrap"><span>On this page</span>{page.sections.map((section,i)=><a href={'#section-'+(i+1)}>{section.nav||section.heading}</a>)}<a href="#questions">Questions</a></div></nav><section class="content-wrap page-body"><div class="content-sections">{page.sections.map((section,i)=><article class="content-section" id={'section-'+(i+1)}><h2>{section.heading}</h2>{section.body.map((paragraph:string)=><p>{paragraph}</p>)}{section.points&&<ul>{section.points.map((point:string)=><li>{point}</li>)}</ul>}</article>)}</div></section><section class="workflow-example"><div class="content-wrap example-grid"><div><span class="product-eyebrow">{page.example.eyebrow||'A PRACTICAL EXAMPLE'}</span><h2>{page.example.title}</h2><p>{page.example.body}</p></div><div class="example-values">{page.example.rows.map(([label,value]:string[])=><div class="example-value"><span>{label}</span><strong>{value}</strong></div>)}</div></div></section><section class="faq-section" id="questions"><div class="content-wrap faq-grid"><div class="faq-heading"><span class="product-eyebrow">QUESTIONS, ANSWERED</span><h2>{page.faqHeading||'A little more clarity.'}</h2><p>Understanding the workflow is part of understanding the figures.</p><a class="product-text-link" href="/help/">Find help & guides →</a></div><div class="faq-list">{page.faq.map(([question,answer]:string[])=><details><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>{related.length>0&&<section class="related-section"><h2>Keep exploring.</h2><div class="related-grid">{related.map(p=><a class="related-card" href={'/'+p.path+'/'}><span>Explore Bursara ↗</span><h3>{p.label}</h3><p>{p.relatedDescription||p.description}</p></a>)}</div></section>}<section class="page-cta"><div><h2>See the workflow for yourself.</h2><p>Explore Bursara Alpha, or discuss your institution’s requirements with our team.</p></div><a class="product-button" href="https://app.bursara.com">Open the workspace ↗</a></section></main></Site>

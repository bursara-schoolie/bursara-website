---
import Site from './Site.astro';
const {title}=Astro.props;
const descriptions:Record<string,string>={'Alpha privacy notice':'How Bursara Alpha handles evaluation data, essential cookies, institution records and optional fiscal sandbox submissions.','Alpha testing terms':'Read the terms for evaluating Bursara Alpha with fictional students and simulated fee transactions.','Page not found':'The requested Bursara page is unavailable. Return to the school finance product site or application.'};
---
<Site title={title+' | Bursara'} description={descriptions[title]} noindex={title==='Page not found'}><main class="legal-body" id="main-content"><nav aria-label="Breadcrumb"><ol class="breadcrumb-list"><li><a href="/">Home</a></li><li>{title}</li></ol></nav><h1>{title}</h1><slot/></main></Site>

<style is:global>@font-face{font-family:Manrope;src:url('/Manrope.ttf');font-display:swap}*{box-sizing:border-box}body{font:15px/1.8 Manrope,system-ui;background:#fbfaf7;color:#172b4d;margin:0}header,main,footer{max-width:950px;margin:auto;padding:35px 25px}header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #dfe4eb}main{min-height:65vh}h1{font-size:40px;letter-spacing:-1.5px}h2{margin-top:35px;font-size:20px}a{color:inherit}p,li{color:#66758c}footer{border-top:1px solid #dfe4eb;font-size:12px}</style>

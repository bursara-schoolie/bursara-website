---
import Site from '../../layouts/Site.astro';
import manual from '../../data/manual-chapters.json';
export function getStaticPaths(){return manual.chapters.map((chapter,index)=>({params:{slug:chapter.slug},props:{chapter,index}}));}
const {chapter,index}=Astro.props;
const previous=manual.chapters[index-1];const next=manual.chapters[index+1];
---
<Site title={chapter.title+' | Bursara user guide'} description={chapter.summary}><main id="main-content"><section class="content-wrap guide-intro"><nav aria-label="Breadcrumb"><ol class="breadcrumb-list"><li><a href="/">Home</a></li><li><a href="/help/">Help & guides</a></li><li>{chapter.title}</li></ol></nav><span class="product-eyebrow">BURSARA USER GUIDE / {String(index+1).padStart(2,'0')}</span><h1>{chapter.title}</h1><p>{chapter.summary}</p><div class="guide-utilities"><a href="/help/">← All guides</a><a href="/downloads/bursara-user-manual.pdf" download>Download the full PDF ↓</a></div></section><div class="content-wrap guide-layout"><aside class="guide-outline"><h2>On this page</h2><nav aria-label="Guide sections">{chapter.sections.map((section,i)=><a href={'#step-section-'+(i+1)}>{section.heading}</a>)}</nav><div><strong>Working in the alpha?</strong><p>Use fictional students and simulated financial transactions.</p><a href="/contact/">Ask the team for help ↗</a></div></aside><article class="guide-article">{chapter.sections.map((section,i)=><section class="guide-procedure" id={'step-section-'+(i+1)}><h2>{section.heading}</h2>{section.paragraphs?.map(paragraph=><p>{paragraph}</p>)}{section.steps&&<ol>{section.steps.map(step=><li>{step}</li>)}</ol>}{section.image&&<figure><a href={section.image.src.replace('images/','/help/images/')} aria-label={'Open full-size image: '+section.image.alt}><img src={section.image.src.replace('images/','/help/images/')} alt={section.image.alt} width={section.image.width} height={section.image.height} loading="lazy" decoding="async"/></a><figcaption>{section.image.caption}</figcaption></figure>}</section>)}<nav class="guide-pagination" aria-label="Previous and next guide">{previous?<a href={'/help/'+previous.slug+'/'}><span>← Previous guide</span><strong>{previous.title}</strong></a>:<span/>}{next&&<a href={'/help/'+next.slug+'/'}><span>Next guide →</span><strong>{next.title}</strong></a>}</nav></article></div></main></Site>
<style>.guide-intro{padding-top:35px;padding-bottom:40px}.guide-intro h1{font-size:49px;letter-spacing:-2px;line-height:1.2;margin:0 0 22px;max-width:860px}.guide-intro>p{font-size:15px;line-height:1.95;max-width:850px;color:#6e7d94}.guide-utilities{display:flex;gap:30px;align-items:center;font-size:11px;font-weight:700;margin-top:25px}.guide-utilities a:last-child{color:#9d7b3d}.guide-layout{display:grid;grid-template-columns:245px minmax(0,1fr);gap:65px;padding-top:25px;padding-bottom:70px;border-top:1px solid #dfe4eb}.guide-outline{position:sticky;top:25px;align-self:start;padding-top:8px}.guide-outline h2{font-size:10px;letter-spacing:1px;text-transform:uppercase;margin:0 0 18px;color:#9b804f}.guide-outline nav{display:grid;gap:0}.guide-outline nav a{font-size:11px;padding:13px 0;border-bottom:1px solid #e2e6ed;line-height:1.8}.guide-outline>div{margin-top:35px;border-left:2px solid #bc9a58;padding:0 0 0 17px}.guide-outline>div>strong{font-size:11px}.guide-outline>div p{font-size:10px;line-height:1.95;color:#62738b}.guide-outline>div a{font-size:10px;font-weight:700}.guide-article{min-width:0}.guide-procedure{padding-bottom:35px;scroll-margin-top:25px}.guide-procedure+.guide-procedure{border-top:1px solid #dfe5ec;padding-top:30px}.guide-procedure h2{font-size:26px;letter-spacing:-.8px;line-height:1.4;margin:0 0 22px}.guide-procedure p{font-size:14px;line-height:2;color:#6b7b92;margin:0 0 19px}.guide-procedure ol{list-style:none;counter-reset:steps;padding:0;margin:0}.guide-procedure li{counter-increment:steps;position:relative;font-size:13px;line-height:2;color:#60728d;padding:0 0 23px 42px}.guide-procedure li:before{content:counter(steps);position:absolute;left:0;top:1px;width:26px;height:26px;border:1px solid #d8e0eb;border-radius:50%;display:grid;place-items:center;color:#8d713b;background:#fff;font-size:10px;font-weight:750}.guide-procedure li:last-child{padding-bottom:0}.guide-procedure figure{margin:0;background:white;border:1px solid #d9e1ec;border-radius:5px;overflow:hidden;box-shadow:0 8px 25px #172b4d07}.guide-procedure figure a{display:block;background:#f4f6f9;padding:12px}.guide-procedure figure img{display:block;width:auto;max-width:100%;height:auto;margin:auto}.guide-procedure figcaption{border-top:1px solid #e2e7ee;padding:15px 19px;font-size:10px;line-height:1.9;color:#62738b;background:#f8fafc}.guide-pagination{display:grid;grid-template-columns:1fr 1fr;gap:20px;border-top:1px solid #dce3ec;padding-top:26px;margin-top:10px}.guide-pagination>a{display:block;padding:20px;background:white;border:1px solid #dce3ec;border-radius:5px;transition:background .15s,border-color .15s}.guide-pagination>a:hover{background:#f2f5f9;border-color:#a7b7ce;color:#172b4d}.guide-pagination span{font-size:9px;color:#9c814b;display:block;margin-bottom:9px}.guide-pagination strong{font-size:12px;line-height:1.8;font-weight:750}.guide-pagination>a:last-child{text-align:right}@media(max-width:1000px){.guide-layout{gap:35px;grid-template-columns:200px minmax(0,1fr)}}@media(max-width:760px){.guide-layout{grid-template-columns:1fr;padding-top:20px;gap:30px}.guide-outline{position:static}.guide-outline nav{display:flex;flex-wrap:wrap;gap:12px 22px}.guide-outline nav a{padding:6px 0;font-size:10px}.guide-outline>div{display:none}.guide-procedure p{font-size:13px}.guide-procedure li{font-size:12px}.guide-intro h1{font-size:40px;letter-spacing:-1.6px}.guide-intro>p{font-size:13px}}@media(max-width:500px){.guide-intro{padding-top:25px;padding-bottom:28px}.guide-intro h1{font-size:34px}.guide-utilities{font-size:10px;gap:20px;flex-wrap:wrap}.guide-procedure h2{font-size:24px}.guide-procedure p{font-size:12px}.guide-procedure li{font-size:11px;line-height:2;padding-left:38px}.guide-procedure figcaption{font-size:9px;padding:13px 15px}.guide-pagination{gap:13px}.guide-pagination>a{padding:15px}.guide-pagination strong{font-size:10px}.guide-layout{padding-bottom:45px}}</style>

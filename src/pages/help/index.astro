---
import Site from '../../layouts/Site.astro';
import manual from '../../data/manual-chapters.json';
const groups=[
 {title:'Getting started',description:'Sign in, find the right screen and understand the account.',slugs:['start-here','money-words','sign-in','passkeys-and-verification','navigation-help','overview']},
 {title:'Programmes & learners',description:'Build the fee structure and enrol the student.',slugs:['create-course','fixed-unit','per-credit-unit','enrol-student','student-account']},
 {title:'Bills & instalments',description:'Raise fees and choose how the balance becomes due.',slugs:['billing-workflows','annual-bill','instalment-schedule','university-unit-bill','receive-and-issue','read-invoice']},
 {title:'Payments & corrections',description:'Record money received, allocate it and handle adjustments.',slugs:['part-payment','allocate-payments','cross-currency','advance-payment','apply-student-credit','refund-unused-credit','credit-fees','receipt-print','print-statement']},
 {title:'Debtors & reporting',description:'Review what remains unpaid and follow the figures.',slugs:['debtors','reports-export','financial-journal']},
 {title:'People & institution access',description:'Manage users, rights and authorised platform support.',slugs:['create-user','user-rights','institution-settings','platform-create-institution','platform-support-access']},
 {title:'Fiscal module & further help',description:'Explore the optional sandbox module and troubleshoot.',slugs:['ebs-settings','ebs-workflow','mobile-use','common-problems','support-and-glossary']}
];
---
<Site title="Bursara help and user guide | School billing and receipts" description="Follow Bursara’s illustrated user guide to set up courses, enrol students, create bills, receive payments, manage balances and configure institution access."><main id="main-content"><section class="content-wrap help-intro"><nav aria-label="Breadcrumb"><ol class="breadcrumb-list"><li><a href="/">Home</a></li><li>Help & guides</li></ol></nav><span class="product-eyebrow">THE BURSARA USER GUIDE</span><h1>A little guidance.<br/>A clearer working day.</h1><p>Follow the steps for the task in front of you. Each guide uses the same screen names and controls as Bursara Alpha, with illustrated examples based on fictional records.</p><div class="product-actions"><a class="product-button" href="/help/start-here/">Start with the basics →</a><a class="product-text-link" href="/downloads/bursara-user-manual.pdf" download>Download the complete PDF ↓</a><a class="product-text-link" href="/downloads/bursara-user-manual.html" download>Download offline HTML ↓</a></div></section><section class="help-library"><div class="content-wrap"><div class="guide-search-row"><label for="guide-search">Find a guide</label><div class="guide-search"><span aria-hidden="true">⌕</span><input id="guide-search" type="search" placeholder="Try: annual bill, part payment, permissions" autocomplete="off"/></div><output id="guide-count" aria-live="polite">{manual.chapters.length} guides</output></div><div id="no-guide-results" hidden><h2>No guides match that search.</h2><p>Try a shorter phrase or contact the team for help.</p></div>{groups.map(group=><section class="guide-group"><div class="guide-group-heading"><h2>{group.title}</h2><p>{group.description}</p></div><div class="guide-cards">{group.slugs.map(slug=>manual.chapters.find(c=>c.slug===slug)).filter(Boolean).map(chapter=><a class="guide-card" href={'/help/'+chapter.slug+'/'} data-search={(chapter.title+' '+chapter.summary).toLowerCase()}><span>USER GUIDE ↗</span><h3>{chapter.title}</h3><p>{chapter.summary}</p></a>)}</div></section>)}</div></section><section class="content-wrap help-boundary"><div><span class="product-eyebrow">TEST WITH CARE</span><h2>A guide to the working alpha.</h2><p>Use fictional learners and simulated transactions. The shared demonstration is visible to other testers, and alpha records may be reset during development. The guides describe current financial workflows; attendance, timetables, automated email delivery and live payment processing are outside the alpha.</p></div><div class="help-contact"><h3>Still need a hand?</h3><p>Tell us the screen, the steps you took and what you expected to happen. Keep personal information out of screenshots and examples.</p><a class="product-text-link" href="/contact/">Contact the team ↗</a></div></section></main></Site>
<script>
const input=document.querySelector<HTMLInputElement>('#guide-search');const count=document.querySelector<HTMLOutputElement>('#guide-count');
input?.addEventListener('input',()=>{const query=input.value.trim().toLowerCase();let visible=0;document.querySelectorAll<HTMLElement>('.guide-card').forEach(card=>{const match=card.dataset.search?.includes(query)===true;card.hidden=!match;if(match)visible++;});document.querySelectorAll<HTMLElement>('.guide-group').forEach(group=>{group.hidden=Array.from(group.querySelectorAll<HTMLElement>('.guide-card')).every(card=>card.hidden);});if(count)count.textContent=`${visible} ${visible===1?'guide':'guides'}`;const empty=document.querySelector<HTMLElement>('#no-guide-results');if(empty)empty.hidden=visible!==0;});
</script>
<style>.help-intro{padding-top:38px;padding-bottom:60px}.help-intro h1{font-size:60px;line-height:1.15;letter-spacing:-2.7px;margin:0 0 25px}.help-intro>p{font-size:15px;line-height:1.95;color:#62738b;max-width:700px;margin-bottom:30px}.help-library{border-top:1px solid #e0e4ea;background:#f3f5f8;padding:35px 0 65px}.guide-search-row{display:flex;align-items:center;gap:20px;margin-bottom:45px}.guide-search-row>label{font-size:12px;font-weight:750}.guide-search{display:flex;align-items:center;gap:10px;border:1px solid #d5dee9;background:white;border-radius:5px;padding:0 14px;flex:1;max-width:540px}.guide-search>span{font-size:24px;color:#62738b}.guide-search input{min-width:0;width:100%;background:transparent;border:0;outline-offset:4px;padding:15px 0;font:inherit;font-size:12px;color:#172b4d}.guide-search input:focus-visible{outline:2px solid #b48b3e}.guide-search-row output{font-size:10px;color:#62738b;margin-left:auto}.guide-group{margin-top:40px}.guide-group-heading{display:flex;justify-content:space-between;align-items:center;gap:25px;margin-bottom:23px}.guide-group h2{font-size:23px;letter-spacing:-.8px;margin:0}.guide-group-heading p{font-size:11px;color:#62738b;margin:0}.guide-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.guide-card{display:block;background:white;border:1px solid #dce3ec;padding:23px;border-radius:5px;transition:background .15s,border-color .15s}.guide-card:hover{background:#f9fafc;border-color:#a6b6cd;color:#172b4d}.guide-card>span{font-size:8px;letter-spacing:1.3px;color:#a0834a;font-weight:800}.guide-card h3{font-size:16px;line-height:1.6;letter-spacing:-.4px;margin:13px 0 10px}.guide-card p{font-size:11px;line-height:1.95;color:#62738b;margin:0}.guide-card[hidden],.guide-group[hidden]{display:none}.help-boundary{display:grid;grid-template-columns:1.4fr 1fr;gap:80px;padding-top:65px;padding-bottom:70px}.help-boundary h2{font-size:30px;letter-spacing:-1px;margin:0 0 18px}.help-boundary p{font-size:13px;line-height:1.95;color:#62738b}.help-contact{padding-left:30px;border-left:2px solid #b48b3e}.help-contact h3{font-size:21px;letter-spacing:-.6px;margin:0 0 15px}#no-guide-results h2{font-size:23px}#no-guide-results p{font-size:13px;color:#7d899a}@media(max-width:900px){.guide-cards{grid-template-columns:1fr 1fr}.guide-group-heading{display:block}.guide-group-heading p{margin-top:9px}.help-boundary{gap:40px}}@media(max-width:620px){.help-intro{padding-top:25px;padding-bottom:40px}.help-intro h1{font-size:40px;letter-spacing:-1.8px}.help-intro>p{font-size:13px}.help-library{padding:25px 0 40px}.guide-search-row{flex-wrap:wrap;gap:12px;margin-bottom:30px}.guide-search-row label{font-size:11px}.guide-search{order:3;flex-basis:100%;max-width:none}.guide-search-row output{font-size:9px}.guide-search input{font-size:11px}.guide-cards{grid-template-columns:1fr;gap:12px}.guide-group{margin-top:30px}.guide-group h2{font-size:22px}.guide-group-heading p{font-size:10px}.guide-card{padding:20px}.guide-card h3{font-size:15px}.help-boundary{grid-template-columns:1fr;gap:25px;padding-top:40px;padding-bottom:45px}.help-boundary h2{font-size:27px}.help-boundary p{font-size:12px}.help-contact{padding-left:23px}}</style>
<style>.guide-search:hover{border-color:#9bacc4}</style>

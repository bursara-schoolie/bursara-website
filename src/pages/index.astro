---
import Site from '../layouts/Site.astro';

const schema = {'@context':'https://schema.org','@graph':[{'@type':'Organization',name:'Streak Technologies Ltd',url:'https://streaktechnologies.com',email:'support@streaktechnologies.com',telephone:'+2302152998',address:{'@type':'PostalAddress',streetAddress:'Royal Road, Pointe aux Cannoniers',addressLocality:'Grand Bay',addressCountry:'MU'}},{'@type':'WebSite',name:'Bursara',url:'https://bursara.com',description:'Student billing, receipts and financial clarity for learning institutions.'}]};
const appUrl = 'https://app.bursara.com';
const features = [
  ['01', '/student-billing/', 'Fees that fit your institution.', 'An annual school fee or a selection of university units. Set prices, enrol students and build the bill around the education you provide.'],
  ['02', '/receipts-and-payments/', 'Every payment has its place.', 'Take part payments, allocate receipts and keep a clear account of what has been paid, what is due and what comes next.'],
  ['03', '/debtors/', 'A clear view of outstanding fees.', 'Follow debtor balances, instalment dates and unapplied credits without losing the student behind the numbers.'],
];
---
<Site schema={schema} title="Bursara | School fees, payments and financial clarity" description="Student billing, receipts and financial management for schools, colleges and training institutions. Explore the Bursara alpha.">
    <main id="main-content">
      <section class="hero wrap">
        <div class="hero-copy"><div class="eyebrow"><span></span> THE SCHOOL FINANCE OFFICE, REIMAGINED</div>
          <h1>Every fee.<br/>Every payment.<br/><em>In clear view.</em></h1>
          <p>From the first invoice to the final instalment. A considered financial workspace for schools, colleges and learning institutions.</p>
          <div class="actions"><a class="button" href={appUrl}>Explore the alpha <span aria-hidden="true">→</span></a><a class="text-link" href="/features/">Meet Bursara →</a></div>
          <div class="hero-note">Built for annual fees, individual units and everything in between.</div>
        </div>
        <div class="preview-scene" aria-label="Illustrative Bursara account preview">
          <div class="stripe"></div><div class="preview-top"><span class="tiny-mark">▥</span><span>STUDENT ACCOUNT</span><span class="demo">ILLUSTRATION</span></div>
          <div class="profile"><div class="avatar">AM</div><div><strong>Alex Morgan</strong><small>High School · Year 1</small></div><span class="chip">Active</span></div>
          <div class="account-values"><div><small>Annual fees</small><strong>MUR 120,000<span>.00</span></strong></div><div><small>Paid to date</small><strong>MUR 25,000<span>.00</span></strong></div></div>
          <div class="progress"><span></span></div><div class="progress-label"><span>Your year, clearly accounted for.</span><strong>21% paid</strong></div>
          <div class="balance"><div><small>Remaining balance</small><strong>MUR 95,000.00</strong></div><span>View statement →</span></div>
          <div class="activity-title">Recent activity <span>View all</span></div>
          <div class="activity"><div class="activity-icon">↓</div><div><strong>Part payment received</strong><small>Bank transfer · Tuition</small></div><b>MUR 25,000</b></div>
          <div class="activity"><div class="activity-icon muted">▤</div><div><strong>Annual fee invoice</strong><small>12 scheduled instalments</small></div><b>MUR 120,000</b></div>
          <div class="preview-footer"><span class="dot"></span> A single account. A complete picture.</div>
        </div>
      </section>
      <section class="institution-bar"><div class="wrap"><span>FOR EVERY KIND OF LEARNING</span><a href="/institutions/schools/">Schools</a><i></i><a href="/institutions/colleges-and-training/">Universities</a><i></i><a href="/institutions/schools/">Academies</a><i></i><a href="/institutions/colleges-and-training/">Training providers</a></div></section>
      <section class="wrap section" id="product"><div class="eyebrow">LESS ADMINISTRATION. MORE UNDERSTANDING.</div><h2>A better rhythm for<br/>your finance office.</h2><div class="feature-grid">{features.map(([number,href,title,description])=><article><span class="number">{number}</span><h3><a href={href}>{title}</a></h3><p>{description}</p><a class="feature-link" href={href}>Explore the workflow ↗</a></article>)}</div></section>
      <section class="billing-section" id="billing"><div class="wrap billing-grid"><div><div class="eyebrow">YOUR INSTITUTION. YOUR BILLING STYLE.</div><h2>One year ahead.<br/>One payment at a time.</h2><p>Issue a bill before collecting, receive payment and issue a paid invoice together, or collect against a schedule of assessed fees.</p><a class="text-link" href={appUrl}>See the financial workspace →</a></div><div class="steps"><article><span>1</span><div><h3>Set the fees</h3><p>Courses, units, currencies and payment terms.</p></div></article><article><span>2</span><div><h3>Bill and collect</h3><p>Invoices, part payments and combined receipts.</p></div></article><article><span>3</span><div><h3>Keep the whole picture</h3><p>Balances, due dates and student statements.</p></div></article></div></div></section>
      <section class="wrap section modules" id="modules"><div><div class="eyebrow">LOCAL WHEN IT NEEDS TO BE.</div><h2>Global foundations.<br/>Local fiscal modules.</h2><p>Financial management sits at the centre. Jurisdiction-specific e-invoicing belongs in optional modules, beginning with EBS for Mauritius.</p></div><article class="module-card"><div class="module-icon">MU</div><div><span class="label">MAURITIUS MODULE</span><h3>EBS e-invoicing</h3><p>Configure the institution's fiscal workflow independently of its student and payment records.</p><small>Optional Mauritius sandbox module. Explicit preparation and submission in the alpha.</small><a class="feature-link" href="/features/#section-4">How modules fit ↗</a></div></article></section>
      <section class="wrap section further-reading"><div><span class="eyebrow">A WORKSPACE WORTH UNDERSTANDING.</span><h2>Find your starting point.</h2></div><div class="reading-grid"><a href="/institutions/schools/"><span>FOR SCHOOLS ↗</span><h3>The school year,<br/>clearly accounted for.</h3><p>Annual fees, parent payments and monthly instalments.</p></a><a href="/institutions/colleges-and-training/"><span>FOR COLLEGES & TRAINING ↗</span><h3>Unit fees that follow<br/>the learner.</h3><p>Programmes, priced modules and responsible payers.</p></a><a href="/multi-currency/"><span>FOR INTERNATIONAL ACCOUNTS ↗</span><h3>Different currencies.<br/>One clear approach.</h3><p>Labelled transactions and separate currency balances.</p></a></div></section><section class="wrap final-cta"><div><span class="eyebrow">BURSARA ALPHA</span><h2>Take a look around.</h2><p>A working space to test, learn and shape what comes next.</p></div><a href={appUrl} class="button light">Open the application ↗</a></section>
      <section class="wrap section contact" id="contact"><div><span class="eyebrow">BY STREAK TECHNOLOGIES LTD</span><h2>Let’s talk school finance.</h2><p>Discuss Bursara for your school, college or learning institution.</p><a class="button" href="mailto:support@streaktechnologies.com?subject=Bursara%20enquiry">Contact the team ↗</a></div><div class="contact-details"><h3>Streak Technologies Ltd</h3><p>Royal Road, Pointe aux Cannoniers<br/>Grand Bay, Mauritius</p><a href="tel:+2302152998">+230 215 2998</a><p>USA: <a href="tel:+13075003256">+1 307 500 3256</a></p><a href="mailto:support@streaktechnologies.com">support@streaktechnologies.com</a><p><a href="https://streaktechnologies.com">streaktechnologies.com ↗</a></p></div></section>
    </main>
</Site>
<style is:global>
@font-face{font-family:Manrope;src:url('/Manrope.ttf') format('truetype');font-display:swap;font-weight:200 800}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#fbfaf7;color:#172b4d;font-family:Manrope,system-ui,sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}button,a{-webkit-tap-highlight-color:transparent}a:focus-visible{outline:3px solid #b58a38;outline-offset:5px}.wrap{max-width:1250px;margin:auto;padding:0 36px}.button{display:inline-flex;align-items:center;justify-content:center;gap:30px;padding:19px 25px;background:#172b4d;color:white;border-radius:7px;font-weight:700;font-size:14px;transition:background .2s,transform .2s}.button:hover{background:#294672;transform:translateY(-1px)}.hero{padding-top:75px;padding-bottom:100px;display:grid;grid-template-columns:1.1fr 1fr;align-items:center;gap:75px}.eyebrow{font-size:10px;letter-spacing:2px;font-weight:800;display:flex;align-items:center;gap:10px}.eyebrow span{width:7px;height:7px;border-radius:100%;background:#bd9546}h1{font-size:clamp(48px,5.2vw,76px);letter-spacing:-4px;line-height:1.12;margin:28px 0}h1 em{font-style:normal;color:#9a7330}p{color:#647087;line-height:1.85;font-size:15px}.hero-copy>p{max-width:450px}.actions{display:flex;align-items:center;gap:30px;margin-top:34px}.text-link{font-size:13px;font-weight:750}.hero-note{font-size:10px;color:#778095;margin-top:30px}.preview-scene{background:#fff;border:1px solid #e0e4ec;border-radius:13px;box-shadow:0 30px 80px #172b4d12,0 3px 8px #172b4d06;overflow:hidden;position:relative;transform:rotate(1deg)}.stripe{height:5px;background:repeating-linear-gradient(125deg,#172b4d 0 34px,#c49a45 34px 40px,#172b4d 40px 44px,#fff 44px 48px)}.preview-top{display:flex;align-items:center;gap:10px;padding:22px 25px;border-bottom:1px solid #eef0f4;font-size:9px;letter-spacing:1px;font-weight:800}.tiny-mark{font-size:24px}.demo{margin-left:auto;font-size:7px;color:#62738b}.profile{display:flex;align-items:center;gap:12px;padding:27px 25px}.avatar{width:44px;height:44px;border-radius:10px;background:#e9edf5;display:grid;place-items:center;font-size:13px;font-weight:800}.profile strong{font-size:14px}.profile small{display:block;color:#62738b;font-size:10px;margin-top:5px}.chip{font-size:9px;background:#eef2fa;border:1px solid #dde4f2;padding:5px 9px;border-radius:5px;margin-left:auto}.account-values{display:grid;grid-template-columns:1fr 1fr;padding:5px 25px 22px;gap:20px}.account-values small,.balance small{display:block;font-size:10px;color:#7e8798;margin-bottom:10px}.account-values strong{font-size:20px;letter-spacing:-.7px}.account-values strong span{font-size:12px;color:#62738b}.progress{height:5px;background:#edf0f5;margin:0 25px;border-radius:5px}.progress span{display:block;width:21%;height:100%;background:#c49a45;border-radius:5px}.progress-label{display:flex;justify-content:space-between;margin:10px 25px 25px;color:#62738b;font-size:8px}.progress-label strong{color:#172b4d}.balance{margin:0 25px;padding:20px;background:#f5f7fb;border-radius:8px;display:flex;align-items:center;justify-content:space-between;gap:10px}.balance strong{font-size:21px;letter-spacing:-.6px}.balance span{font-size:8px;font-weight:800}.activity-title{font-size:11px;font-weight:800;margin:25px 25px 4px;display:flex;justify-content:space-between}.activity-title span{font-size:8px;color:#62738b}.activity{display:flex;align-items:center;gap:10px;padding:17px 25px;border-bottom:1px solid #f0f1f4}.activity-icon{background:#f0ede5;border-radius:7px;display:grid;place-items:center;width:30px;height:30px;color:#987436}.activity-icon.muted{background:#edf0f6;color:#6a7891}.activity strong{display:block;font-size:9px}.activity small{display:block;font-size:8px;color:#62738b;margin-top:5px}.activity b{margin-left:auto;font-size:10px}.preview-footer{padding:18px 25px;background:#fafbfc;display:flex;align-items:center;gap:7px;font-size:8px;color:#62738b}.dot{width:4px;height:4px;background:#9b7a3b;border-radius:50%}.institution-bar{border-top:1px solid #e7e7e3;border-bottom:1px solid #e7e7e3;background:#f5f4ef}.institution-bar .wrap{display:flex;align-items:center;justify-content:space-between;min-height:86px;gap:20px}.institution-bar span{font-size:8px;letter-spacing:1.5px;color:#62738b}.institution-bar a{font-size:13px;font-weight:650}.institution-bar i{height:5px;width:5px;border-radius:50%;background:#c6b894}.section{padding-top:95px;padding-bottom:95px}h2{font-size:42px;letter-spacing:-1.8px;line-height:1.25;margin:21px 0 25px}.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:50px;margin-top:50px}.feature-grid article{border-top:1px solid #dadddf;padding-top:24px}.number{font-size:11px;color:#a88546;font-weight:800}h3{font-size:19px;letter-spacing:-.6px;line-height:1.5;margin:17px 0 10px}.feature-grid p{font-size:13px}.billing-section{background:#eef1f6;padding:85px 0}.billing-grid{display:grid;grid-template-columns:1fr 1fr;gap:100px;align-items:center}.billing-grid p{max-width:430px;font-size:14px}.billing-grid .text-link{display:block;margin-top:25px}.steps article{display:flex;gap:25px;align-items:center;padding:24px 0;border-bottom:1px solid #d9e0ea}.steps article:last-child{border-bottom:0}.steps article>span{width:38px;height:38px;background:#fff;border:1px solid #d9e0ea;border-radius:50%;display:grid;place-items:center;font-size:12px}.steps h3{margin:0;font-size:17px}.steps p{margin:5px 0 0;font-size:12px}.modules{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:90px}.modules>div>p{font-size:13px;max-width:430px}.module-card{background:#fff;border:1px solid #e1e4eb;padding:35px;border-radius:12px;display:flex;gap:25px}.module-icon{width:45px;height:45px;background:#eaf0fa;border-radius:9px;display:grid;place-items:center;font-size:13px;flex-shrink:0;font-weight:800}.label{font-size:8px;letter-spacing:1.3px;font-weight:800;color:#8b94a4}.module-card h3{margin-top:8px}.module-card p{font-size:12px}.module-card small{font-size:9px;color:#9b814e;line-height:1.7;display:block}.final-cta{padding:45px 55px;display:flex;justify-content:space-between;align-items:center;background:#172b4d;color:white;border-radius:14px;margin-bottom:65px;gap:20px}.final-cta .eyebrow{color:#d0b679}.final-cta h2{margin:12px 0}.final-cta p{font-size:12px;color:#bdc8da}.button.light{background:#fff;color:#172b4d}.contact{display:grid;grid-template-columns:1fr 1fr;gap:65px;border-top:1px solid #e1e4eb}.contact .button{margin-top:18px}.contact-details{border-left:2px solid #c49a45;padding-left:30px;font-size:14px}.contact-details a:hover{text-decoration:underline}@media(max-width:1000px){.hero{gap:35px;padding-top:40px}h1{font-size:57px}.account-values strong{font-size:16px}.balance strong{font-size:17px}.billing-grid,.modules{gap:45px}.institution-bar .wrap{flex-wrap:wrap;justify-content:center;padding:20px}.institution-bar span{width:100%;text-align:center}}@media(max-width:720px){.wrap{padding-left:22px;padding-right:22px}.hero{grid-template-columns:1fr;padding-top:35px;padding-bottom:55px;gap:45px}h1{font-size:55px;letter-spacing:-2.6px}.hero-copy>p{font-size:14px}.preview-scene{transform:none}.account-values strong{font-size:19px}.balance strong{font-size:20px}.feature-grid,.billing-grid,.modules,.contact{grid-template-columns:1fr}.feature-grid{gap:25px}.section{padding-top:60px;padding-bottom:60px}h2{font-size:34px}.billing-section{padding:55px 0}.final-cta{margin:0 18px 40px;padding:30px;flex-direction:column;align-items:flex-start}.final-cta h2{font-size:30px}.module-card{padding:25px;gap:16px}.institution-bar a{font-size:11px}.institution-bar .wrap{gap:12px}}
.feature-link{display:inline-block;margin-top:17px;font-size:11px;font-weight:750;color:#957035}.feature-grid h3 a:hover{color:#957035}.further-reading{padding-top:15px}.reading-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:40px}.reading-grid>a{background:white;border:1px solid #dee4ed;border-radius:7px;padding:28px;transition:background .15s,border-color .15s}.reading-grid>a:hover{background:#f2f5f9;border-color:#aab9cd;color:#172b4d}.reading-grid>a>span{font-size:8px;letter-spacing:1.2px;color:#a1844e;font-weight:800}.reading-grid h3{font-size:22px;line-height:1.5;margin:18px 0 13px}.reading-grid p{font-size:12px;margin:0}@media(max-width:720px){.reading-grid{grid-template-columns:1fr;gap:15px}.reading-grid>a{padding:24px}.further-reading{padding-top:0}}
</style>
<style>@media(max-width:380px){.actions{flex-wrap:wrap;gap:20px}.account-values{padding-left:18px;padding-right:18px;gap:12px}.account-values strong{font-size:16px}.account-values strong span{font-size:10px}.balance{margin-left:18px;margin-right:18px;padding:15px}.balance strong{font-size:17px}.balance span{font-size:7px}.profile{padding-left:18px;padding-right:18px}.activity{padding-left:18px;padding-right:18px}.activity b{font-size:9px}}</style>
